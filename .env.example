# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Supabase Postgres
# ---------------------------------------------------------------------------
# Both URLs come from the Supabase dashboard: Project Settings → Database →
# Connection string. They point at the same database over different ports, and
# the app needs both.
#
# DATABASE_URL is the transaction-mode pooler (port 6543). Serverless functions
# open a connection per invocation, so app queries must go through the pooler or
# the database runs out of connections under load. `pgbouncer=true` tells Prisma
# to stop using prepared statements, which the transaction pooler cannot hold
# across statements; without it you get "prepared statement already exists"
# errors under concurrency. connection_limit=1 keeps a single function instance
# from hoarding pooled connections.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL is a direct session connection (port 5432), used only by Prisma
# Migrate. Migrations take advisory locks and run DDL, neither of which survives
# the transaction pooler. Nothing at request time uses this.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase Storage (submission documents)
# ---------------------------------------------------------------------------
# Project Settings → API. The URL is public; the service-role key is NOT — it
# bypasses Row Level Security entirely. It is read only by server-side code
# (lib/supabase-admin.ts) and must never be given a NEXT_PUBLIC_ prefix.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-the-service-role-key"

# The private bucket holding submitted chapters. Must exist before first upload
# — see SUPABASE.md for the one-time setup.
SUPABASE_STORAGE_BUCKET="submissions"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# NextAuth session signing secret. Generate a real one for every environment
# with: openssl rand -base64 32 — never reuse the same secret across
# dev/staging/production, and never commit a real value.
NEXTAUTH_SECRET="replace-with-a-generated-secret"

# The canonical URL this deployment is served from (must be https:// in production).
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Public metadata
# ---------------------------------------------------------------------------
# Public origin used to build absolute URLs in metadata: Open Graph and Twitter
# image tags, the canonical link, robots.txt and sitemap.xml. Social crawlers
# reject relative image URLs, so this has to be the real public origin in
# production — otherwise shared links preview against localhost.
# Safe to expose: it's the site's own address, and NEXT_PUBLIC_* is inlined
# into the client bundle by design.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
