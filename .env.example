# Copy this file to .env and fill in real values. Never commit .env.

# Prisma datasource. For local dev this points at a SQLite file.
# For production, switch prisma/schema.prisma's datasource provider to
# "postgresql" (see DECISIONS.md) and point this at your Postgres instance,
# e.g. postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL="file:./dev.db"

# NextAuth session signing secret. Generate a real one for every environment
# with: openssl rand -base64 32 — never reuse the same secret across
# dev/staging/production, and never commit a real value.
NEXTAUTH_SECRET="replace-with-a-generated-secret"

# The canonical URL this deployment is served from (must be https:// in production).
NEXTAUTH_URL="http://localhost:3000"
