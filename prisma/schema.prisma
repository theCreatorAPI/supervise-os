generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase's transaction-mode pooler (port 6543). Serverless functions open a
  // connection per invocation, so app queries must go through the pooler.
  url      = env("DATABASE_URL")
  // Migrations and introspection need a direct session (port 5432): the
  // transaction pooler can't run the advisory locks and DDL that Prisma Migrate
  // depends on.
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  LECTURER
  MANAGEMENT
}

enum UserStatus {
  ACTIVE
  PENDING_ACTIVATION
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  APPROVED
}

enum RiskLevel {
  NORMAL
  AT_RISK
  CRITICAL
}

enum RiskIndicatorType {
  STALE_SUBMISSION
  MILESTONE_OVERDUE
  REPEATED_RETURNS
  REVIEW_OVERDUE
  MEETING_MISSED
}

enum RiskIndicatorStatus {
  ACTIVE
  RESOLVED
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  DEFENDED
}

enum ReviewDecision {
  APPROVED
  RETURNED
  COMMENT_ONLY
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Department {
  id   String @id @default(cuid())
  name String @unique

  users    User[]
  projects Project[]
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  passwordHash   String?
  role           Role
  status         UserStatus @default(ACTIVE)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  title          String?
  maxLoad        Int        @default(15)
  matricNumber   String?    @unique
  /// The intake a student belongs to, e.g. "2025/2026". Set when their
  /// supervisor invites them, and copied onto Project.session when their topic
  /// is approved — so a student invited in one session never appears under
  /// another, even before they have a project.
  academicSession String?
  staffId        String?    @unique
  activationToken String?   @unique
  pendingSupervisorId String?
  notificationsEnabled Boolean   @default(true)
  meetingReminders     Boolean   @default(true)
  /// Submission activity alerts, kept separate from general project activity so
  /// the three switches on the settings screen control three different things.
  submissionUpdates    Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime   @default(now())

  projectsAsStudent  Project[]       @relation("StudentProjects")
  projectsSupervised Project[]       @relation("SupervisorProjects")
  reviewsGiven       Review[]
  notifications      Notification[]
  auditEvents        AuditEvent[]
  topicProposals     TopicProposal[]
}

model Project {
  id           String        @id @default(cuid())
  title        String
  description  String?
  programme    String?
  session      String?
  studentId    String
  student      User          @relation("StudentProjects", fields: [studentId], references: [id])
  supervisorId String
  supervisor   User          @relation("SupervisorProjects", fields: [supervisorId], references: [id])
  departmentId String?
  department   Department?   @relation(fields: [departmentId], references: [id])
  status       ProjectStatus @default(ACTIVE)
  riskLevel    RiskLevel     @default(NORMAL)
  riskReasons  String        @default("[]")
  createdAt    DateTime      @default(now())

  milestones     Milestone[]
  meetings       Meeting[]
  riskIndicators RiskIndicator[]
  auditEvents    AuditEvent[]
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  order       Int
  status      MilestoneStatus @default(NOT_STARTED)
  dueDate     DateTime?
  approvedAt  DateTime?
  submissions Submission[]
}

model Submission {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  version     Int
  fileUrl     String
  fileName    String
  fileSize    Int       @default(0)
  submittedAt DateTime  @default(now())

  reviews Review[]
}

model Review {
  id           String         @id @default(cuid())
  submissionId String
  submission   Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  lecturerId   String
  lecturer     User           @relation(fields: [lecturerId], references: [id])
  comment      String
  decision     ReviewDecision
  createdAt    DateTime       @default(now())
}

model Meeting {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String   @default("Supervision meeting")
  scheduledAt DateTime
  notes       String?
  /// What the student agreed to do before the next meeting. Written by the
  /// supervisor from the meeting detail page, after the meeting has happened.
  actionItems String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model RiskIndicator {
  id          String               @id @default(cuid())
  projectId   String
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        RiskIndicatorType
  status      RiskIndicatorStatus  @default(ACTIVE)
  detail      String
  triggeredAt DateTime             @default(now())
  resolvedAt  DateTime?
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action      String
  description String
  createdAt   DateTime @default(now())
}

model TopicProposal {
  id        String         @id @default(cuid())
  studentId String
  student   User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  status    ProposalStatus @default(PENDING)
  /// What the supervisor told the student when approving or requesting changes.
  /// The approval screen shows it back to both sides after the decision, so the
  /// reason a topic was sent back does not live only in a notification.
  feedback  String?
  createdAt DateTime       @default(now())
  decidedAt DateTime?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  link      String?
}
